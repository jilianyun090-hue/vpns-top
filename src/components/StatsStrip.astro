---
import { stats } from '../data/homepage';
---

<div class="border-b border-slate-200 bg-white">
  <div class="container-xl">
    <div class="grid grid-cols-2 divide-x divide-y divide-slate-200 border-x border-slate-200 md:grid-cols-4 md:divide-y-0">
      {stats.map((item, index) => (
        <div class="relative px-5 py-7 sm:px-7">
          <span class="absolute right-4 top-3 font-mono text-[10px] text-slate-300">0{index + 1}</span>
          <span class="block text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">{item.value}</span>
          <span class="mt-2 block text-xs font-semibold text-slate-500">{item.label}</span>
        </div>
      ))}
    </div>
  </div>
</div>

---
interface Props {
  headers: string[];
  rows: (string | number | boolean)[][];
  rowLinks?: (string | undefined)[];
  caption?: string;
}

const { headers, rows, rowLinks = [], caption } = Astro.props;

function renderCell(val: string | number | boolean): string {
  if (val === true) return '是';
  if (val === false) return '否';
  return String(val);
}
---

<div class="overflow-x-auto border border-slate-300 bg-white">
  <table class="w-full min-w-[760px] border-collapse text-sm">
    {caption && <caption class="border-b border-slate-200 px-5 py-3 text-left text-[11px] text-slate-500">{caption}</caption>}
    <thead>
      <tr class="bg-ink text-[#fbf8f0]">
        {headers.map((header, index) => (
          <th class:list={[
            'whitespace-nowrap px-4 py-4 text-[11px] font-bold uppercase tracking-wide',
            index === 0 ? 'sticky left-0 z-10 bg-ink text-left' : 'text-center'
          ]}>{header}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row, rowIndex) => (
        <tr class="border-t border-slate-200 transition-colors hover:bg-brand-50/60">
          {row.map((cell, cellIndex) => (
            <td class:list={[
              'whitespace-nowrap px-4 py-3.5',
              cellIndex === 0
                ? 'sticky left-0 z-10 border-r border-slate-200 bg-white text-left font-bold text-slate-950'
                : 'text-center text-slate-600',
              cell === true && 'font-bold text-emerald-700',
              cell === false && 'text-slate-400'
            ]}>
              {cellIndex === 0 && rowLinks[rowIndex] ? (
                <div class="flex items-center justify-between gap-3">
                  <span>{renderCell(cell)}</span>
                  <a
                    href={rowLinks[rowIndex]}
                    target="_blank"
                    rel="noopener noreferrer sponsored"
                    aria-label={`访问${renderCell(cell)}官网`}
                    class="inline-flex shrink-0 items-center rounded-full border border-brand-200 bg-brand-50 px-2 py-1 text-[11px] font-bold text-brand-700 transition hover:border-brand-400 hover:bg-brand-100 hover:text-brand-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2"
                  >
                    官网 ↗
                  </a>
                </div>
              ) : renderCell(cell)}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

---
// ComparisonTable: responsive horizontal matrix comparison
// Pass headers array and rows as 2D array (first cell = row label)

interface Props {
  headers: string[];
  rows:    (string | number | boolean)[][];
  caption?: string;
}

const { headers, rows, caption } = Astro.props;

function renderCell(val: string | number | boolean): string {
  if (val === true)  return '✅';
  if (val === false) return '❌';
  return String(val);
}
---

<div class="overflow-x-auto rounded-xl border border-white/8 scrollbar-thin">
  <table class="w-full text-sm border-collapse min-w-[600px]">
    {caption && (
      <caption class="text-xs text-slate-500 text-left px-4 py-2 border-b border-white/5">
        {caption}
      </caption>
    )}
    <thead>
      <tr class="bg-surface-700/60">
        {headers.map((h, i) => (
          <th class:list={[
            'px-4 py-3 text-xs font-semibold text-slate-300 whitespace-nowrap',
            i === 0 ? 'text-left sticky left-0 bg-surface-700 z-10' : 'text-center'
          ]}>
            {h}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row, ri) => (
        <tr class:list={[
          'border-t border-white/5 transition-colors hover:bg-white/3',
          ri % 2 === 0 ? 'bg-transparent' : 'bg-surface-800/30'
        ]}>
          {row.map((cell, ci) => (
            <td class:list={[
              'px-4 py-3 text-slate-300 whitespace-nowrap',
              ci === 0 ? 'font-semibold text-white text-left sticky left-0 bg-surface-800 z-10 border-r border-white/5' : 'text-center text-slate-400'
            ]}>
              {renderCell(cell)}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

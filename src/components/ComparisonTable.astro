---
// ComparisonTable: responsive horizontal matrix comparison
// Pass headers array and rows as 2D array (first cell = row label)

interface Props {
  headers: string[];
  rows:    (string | number | boolean)[][];
  caption?: string;
}

const { headers, rows, caption } = Astro.props;

function renderCell(val: string | number | boolean): string {
  if (val === true)  return '✅';
  if (val === false) return '❌';
  return String(val);
}
---

<div class="overflow-x-auto rounded-xl border border-slate-200 scrollbar-thin">
  <table class="w-full text-sm border-collapse min-w-[600px]">
    {caption && (
      <caption class="text-xs text-slate-500 text-left px-4 py-2 border-b border-slate-100">
        {caption}
      </caption>
    )}
    <thead>
      <tr class="bg-slate-100">
        {headers.map((h, i) => (
          <th class:list={[
            'px-4 py-3 text-xs font-semibold text-slate-600 whitespace-nowrap',
            i === 0 ? 'text-left sticky left-0 bg-slate-100 z-10' : 'text-center'
          ]}>
            {h}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row, ri) => (
        <tr class:list={[
          'border-t border-slate-100 transition-colors hover:bg-brand-50/50',
          ri % 2 === 0 ? 'bg-white' : 'bg-slate-50/60'
        ]}>
          {row.map((cell, ci) => (
            <td class:list={[
              'px-4 py-3 whitespace-nowrap',
              ci === 0 ? 'font-semibold text-slate-800 text-left sticky left-0 bg-white z-10 border-r border-slate-100' : 'text-center text-slate-600'
            ]}>
              {renderCell(cell)}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

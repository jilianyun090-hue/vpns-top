---
interface Props {
  mark: string;
  title: string;
  description: string;
  href: string;
  meta?: string;
}

const { mark, title, description, href, meta } = Astro.props;
---

<a
  href={href}
  class="group flex min-h-[180px] flex-col border border-stone-300/80 bg-[#fbf8f0]/75 p-5 transition-all duration-300 hover:-translate-y-1 hover:border-brand-500 hover:bg-[#fffdf7] hover:shadow-[0_20px_44px_rgba(62,77,68,0.12)] focus-visible:-translate-y-1"
>
  <div class="flex items-start justify-between gap-4">
    <span class="flex h-10 w-10 items-center justify-center rounded-full border border-brand-300 font-serif text-base text-brand-700 transition-colors group-hover:border-brand-600 group-hover:bg-brand-50">
      {mark}
    </span>
    {meta && <span class="text-[11px] font-medium tracking-wide text-stone-400">{meta}</span>}
  </div>
  <h2 class="mt-6 text-xl font-bold text-ink transition-colors group-hover:text-brand-800">{title}</h2>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-stone-500">{description}</p>
  <span class="mt-5 text-xs font-semibold text-brand-700">进入栏目 →</span>
</a>

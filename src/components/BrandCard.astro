---
interface Props {
  name: string;
  slug: string;
  rating: number;
  tagline?: string;
  nodeTypes?: string[];
  streamingSupport?: string[];
  minPrice?: number;
  referralId?: string;
  tags?: string[];
  featured?: boolean;
}

const {
  name, slug, rating, tagline, nodeTypes = [], streamingSupport = [],
  minPrice, referralId, featured = false
} = Astro.props;

const hasVerifiedRating = rating > 0;
---

<article class:list={[
  'group relative flex h-full flex-col border bg-white transition-all duration-300 ease-out will-change-transform hover:-translate-y-1.5 hover:border-brand-500 hover:bg-brand-50/40 hover:shadow-[0_20px_45px_rgba(67,87,76,0.18)] focus-within:-translate-y-1.5 focus-within:border-brand-500 focus-within:bg-brand-50/40 focus-within:shadow-[0_20px_45px_rgba(67,87,76,0.18)]',
  featured
    ? 'border-slate-300 shadow-[inset_0_3px_0_#526b5d]'
    : 'border-slate-200'
]}>
  <span class:list={[
    'pointer-events-none absolute inset-x-[-1px] top-[-1px] z-10 h-[2px] origin-left bg-brand-600 transition-transform duration-300',
    featured ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100 group-focus-within:scale-x-100'
  ]} aria-hidden="true"></span>

  <div class="flex items-start justify-between border-b border-slate-200 p-5 transition-colors duration-300 group-hover:border-brand-200 group-hover:bg-brand-50/60 group-focus-within:border-brand-200 group-focus-within:bg-brand-50/60">
    <div class="min-w-0 pr-4">
      {featured && (
        <span class="mb-3 inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-[0.14em] text-brand-700">
          <span class="h-1.5 w-1.5 bg-brand-600"></span>
          推荐
        </span>
      )}
      <h3 class="truncate text-xl font-extrabold tracking-tight text-slate-950">
        <a href={`/brands/${slug}/`} class="hover:text-brand-600">{name}</a>
      </h3>
      {tagline && <p class="mt-2 line-clamp-2 min-h-[44px] text-xs leading-relaxed text-slate-500">{tagline}</p>}
    </div>

    <div class="shrink-0 border-l border-slate-200 pl-4 text-right transition-colors duration-300 group-hover:border-brand-200 group-focus-within:border-brand-200">
      <span class:list={[
        'block font-black leading-none tracking-[-0.04em] text-slate-950 transition-colors duration-300 group-hover:text-brand-600 group-focus-within:text-brand-600',
        hasVerifiedRating ? 'text-3xl' : 'text-sm'
      ]}>{hasVerifiedRating ? rating.toFixed(1) : '待评'}</span>
      <span class="mt-1 block text-[9px] font-bold uppercase tracking-wider text-slate-400">
        {hasVerifiedRating ? 'Score / 10' : '核验中'}
      </span>
    </div>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="mb-5 grid grid-cols-2 gap-x-3 gap-y-2 text-[11px]">
      {nodeTypes.slice(0, 3).map((item) => (
        <span class="flex items-center gap-2 text-slate-600">
          <span class="h-1 w-1 bg-brand-500"></span>{item}
        </span>
      ))}
      {streamingSupport.slice(0, 2).map((item) => (
        <span class="flex items-center gap-2 text-slate-600">
          <span class="h-1 w-1 bg-emerald-500"></span>{item}
        </span>
      ))}
    </div>

    <div class="mt-auto flex items-end justify-between border-t border-slate-200 pt-4">
      <div>
        <span class="block text-[10px] font-semibold uppercase tracking-wider text-slate-400">Entry price</span>
        {minPrice !== undefined ? (
          <span class="mt-1 block text-sm text-slate-600">
            <strong class="text-lg font-black text-slate-950">¥{minPrice.toFixed(1)}</strong>
            <span class="text-[10px]">/{minPrice === 1.0 ? '次' : '月'}</span>
          </span>
        ) : (
          <span class="mt-1 block text-xs text-slate-400">价格详见官网</span>
        )}
      </div>

      <div class="flex items-center gap-2">
        <a href={`/brands/${slug}/`} class="text-xs font-bold text-slate-600 transition-transform group-hover:translate-x-0.5 group-hover:text-brand-600">评测 →</a>
        {referralId && (
          <a href={`/go/${referralId}/`} target="_blank" rel="noopener noreferrer sponsored" class="bg-ink px-3 py-2 text-xs font-bold text-[#fbf8f0] hover:bg-brand-700">
            官网
          </a>
        )}
      </div>
    </div>
  </div>
</article>

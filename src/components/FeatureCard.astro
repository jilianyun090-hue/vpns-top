---
interface Props {
  icon: string;
  title: string;
  description: string;
  href: string;
  cta?: string;
}

const { icon, title, description, href, cta = '查看更多' } = Astro.props;
---

<a href={href} class="group relative flex min-h-[220px] flex-col border border-slate-200 bg-white p-6 transition-all duration-300 ease-out hover:-translate-y-1 hover:border-brand-400 hover:bg-brand-50/40 hover:shadow-[0_18px_40px_rgba(67,87,76,0.13)]">
  <div class="flex items-start justify-between">
    <span class="flex h-11 w-11 items-center justify-center rounded-full border border-brand-200 bg-brand-50/60 font-serif text-lg text-brand-700 transition-all group-hover:border-brand-500 group-hover:bg-brand-100" aria-hidden="true">{icon}</span>
    <span class="font-mono text-[10px] text-slate-300">↗</span>
  </div>
  <div class="mt-8">
    <h3 class="text-lg font-extrabold text-slate-950 group-hover:text-brand-600">{title}</h3>
    <p class="mt-2 text-sm leading-relaxed text-slate-500">{description}</p>
  </div>
  <div class="mt-auto pt-5 text-xs font-bold text-slate-700 group-hover:text-brand-600">
    {cta} <span aria-hidden="true">→</span>
  </div>
</a>

---
interface Props {
  icon:        string;
  title:       string;
  description: string;
  href:        string;
  cta?:        string;
}

const { icon, title, description, href, cta = '查看更多' } = Astro.props;
---

<a href={href} class="card card-hover p-6 flex flex-col gap-4 group">
  <div class="w-12 h-12 rounded-xl bg-surface-700 flex items-center justify-center text-2xl
              group-hover:bg-brand-900/60 transition-colors duration-300" aria-hidden="true">
    {icon}
  </div>
  <div>
    <h3 class="font-bold text-white text-base mb-1.5 group-hover:text-brand-300 transition-colors">
      {title}
    </h3>
    <p class="text-sm text-slate-400 leading-relaxed">{description}</p>
  </div>
  <div class="mt-auto flex items-center gap-1.5 text-xs font-semibold text-brand-400
              group-hover:text-brand-300 transition-colors">
    {cta}
    <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 16 16" fill="currentColor">
      <path d="M6.22 4.22a.75.75 0 0 1 1.06 0l3.5 3.5a.75.75 0 0 1 0 1.06l-3.5 3.5a.75.75 0 0 1-1.06-1.06L9.19 8 6.22 5.03a.75.75 0 0 1 0-1.06Z"/>
    </svg>
  </div>
</a>

---
import { heroHighlights } from '../data/homepage';
---

<section class="relative overflow-hidden border-b border-stone-300/60 bg-[#f7f4ec]/55">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -right-24 top-8 h-[520px] w-[520px] rounded-full border border-brand-900/10"></div>
    <div class="absolute right-2 top-24 h-[390px] w-[390px] rounded-full border border-brand-900/[0.07]"></div>
    <div class="absolute right-28 top-48 h-[160px] w-[160px] rounded-full bg-brand-600/[0.05] blur-2xl"></div>
    <div class="absolute bottom-0 left-0 h-px w-full bg-gradient-to-r from-transparent via-brand-800/20 to-transparent"></div>
  </div>

  <div class="container-xl relative py-14 lg:py-20">
    <div class="grid items-start gap-12 lg:grid-cols-[1.25fr_.75fr]">
      <div class="animate-in">
        <div class="mb-6 flex items-center gap-3 text-[11px] font-semibold tracking-[0.16em] text-brand-700">
          <span class="h-px w-9 bg-brand-600"></span>
          独立评测 · 清醒选择 · 2026 持续更新
        </div>

        <h1 class="max-w-4xl font-serif text-4xl font-bold leading-[1.18] tracking-[-0.035em] text-ink sm:text-5xl lg:text-[56px]">
          机场评测与使用指南
          <span class="mt-3 block font-normal text-brand-700">把排行、教程与选购决策分开讲清楚</span>
        </h1>

        <p class="mt-7 max-w-2xl border-l border-brand-500/60 pl-5 text-base leading-[1.9] text-stone-600 sm:text-lg">
          独立整理 30+ 服务商的线路、价格、稳定性与解锁表现。首页只提供清晰入口，完整内容分别进入评测、使用、选购、专题与 AI 工具栏目。
        </p>

        <div class="mt-9 flex flex-wrap gap-x-7 gap-y-3 border-t border-stone-300/70 pt-5 text-xs text-stone-500">
          {['不接受厂商付费赞助', '晚高峰真实环境实测', '外链中转加密保护'].map((item) => (
            <span class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-600"></span>
              {item}
            </span>
          ))}
        </div>
      </div>

      <nav class="animate-in delay-200 relative mx-auto w-full max-w-md" aria-label="首页阅读路径">
        <div class="absolute -left-8 -top-8 font-serif text-7xl text-brand-900/[0.06]" aria-hidden="true">阅</div>
        <div class="border border-stone-300/80 bg-[#fbf8f0]/72 p-6 shadow-[0_24px_64px_rgba(56,68,60,0.08)] backdrop-blur-sm sm:p-8">
          <div class="flex items-center justify-between border-b border-stone-300/70 pb-4">
            <div>
              <p class="font-serif text-lg font-bold text-ink">阅读路径</p>
              <p class="mt-1 text-[10px] tracking-[0.16em] text-stone-400">CONTENT DIRECTORY</p>
            </div>
            <span class="font-serif text-3xl text-brand-500">目</span>
          </div>

          <div class="divide-y divide-stone-200/80">
            {heroHighlights.map((item, index) => (
              <div class="group grid grid-cols-[38px_1fr_auto] items-center gap-3 py-4">
                <span class="font-serif text-xs text-brand-500">0{index + 1}</span>
                <p class="text-sm font-semibold text-stone-700 transition-colors group-hover:text-brand-800">{item.text}</p>
                <span class="text-brand-500 transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </div>
            ))}
          </div>

          <p class="border-t border-stone-300/70 pt-4 text-xs leading-relaxed text-stone-500">
            从栏目页进入，再按分类或文章继续阅读。
          </p>
        </div>
      </nav>
    </div>
  </div>
</section>

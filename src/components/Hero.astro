---
import { heroHighlights } from '../data/homepage';
---

<section class="relative overflow-hidden bg-gradient-to-br from-brand-600 via-brand-700 to-brand-900 section">
  <!-- Background decorations -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <!-- Radial gradient blob -->
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 -right-20 w-72 h-72 bg-purple-400/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-1/3 w-64 h-64 bg-white/5 rounded-full blur-2xl"></div>
    <!-- Grid pattern -->
    <div class="absolute inset-0 opacity-[0.06]"
         style="background-image: linear-gradient(rgba(255,255,255,0.8) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.8) 1px, transparent 1px); background-size: 40px 40px;"></div>
  </div>

  <div class="container-xl relative">
    <div class="grid lg:grid-cols-2 gap-12 items-center">

      <!-- Left: Text Content -->
      <div class="max-w-2xl animate-in">
        <!-- Label -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold
                    bg-white/20 text-white border border-white/30 mb-6">
          <span class="w-1.5 h-1.5 bg-white rounded-full animate-pulse"></span>
          独立评测 · 数据每周更新
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black leading-[1.1] text-white mb-6">
          找到最适合你的
          <span class="block mt-1 text-amber-300">机场 &amp; VPN</span>
        </h1>

        <!-- Subtext -->
        <p class="text-lg text-blue-100 leading-relaxed mb-8 max-w-lg">
          专业中文评测平台，覆盖 30+ 服务商。独立测速、安全审计、流媒体解锁实测，帮你做出最优选择。
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-3 mb-10">
          <a href="/brands/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl
                     bg-white text-brand-700 font-bold text-base shadow-lg hover:bg-blue-50
                     transition-all duration-200 hover:-translate-y-0.5">
            查看品牌排名
            <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor">
              <path d="M6.22 4.22a.75.75 0 0 1 1.06 0l3.5 3.5a.75.75 0 0 1 0 1.06l-3.5 3.5a.75.75 0 0 1-1.06-1.06L9.19 8 6.22 5.03a.75.75 0 0 1 0-1.06Z"/>
            </svg>
          </a>
          <a href="/compare/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl
                     bg-white/10 hover:bg-white/20 text-white font-medium text-base
                     border border-white/30 transition-all duration-200">
            横向对比表格
          </a>
        </div>

        <!-- Trust badges -->
        <div class="flex flex-wrap gap-3 text-xs text-blue-100">
          <span class="flex items-center gap-1">
            <svg class="w-4 h-4 text-green-300" viewBox="0 0 16 16" fill="currentColor">
              <path d="M12.207 4.793a1 1 0 0 1 0 1.414l-5 5a1 1 0 0 1-1.414 0l-2.5-2.5a1 1 0 0 1 1.414-1.414L6.5 9.086l4.293-4.293a1 1 0 0 1 1.414 0Z"/>
            </svg>
            不接受厂商赞助测评
          </span>
          <span class="flex items-center gap-1">
            <svg class="w-4 h-4 text-green-300" viewBox="0 0 16 16" fill="currentColor">
              <path d="M12.207 4.793a1 1 0 0 1 0 1.414l-5 5a1 1 0 0 1-1.414 0l-2.5-2.5a1 1 0 0 1 1.414-1.414L6.5 9.086l4.293-4.293a1 1 0 0 1 1.414 0Z"/>
            </svg>
            真实环境测速
          </span>
          <span class="flex items-center gap-1">
            <svg class="w-4 h-4 text-green-300" viewBox="0 0 16 16" fill="currentColor">
              <path d="M12.207 4.793a1 1 0 0 1 0 1.414l-5 5a1 1 0 0 1-1.414 0l-2.5-2.5a1 1 0 0 1 1.414-1.414L6.5 9.086l4.293-4.293a1 1 0 0 1 1.414 0Z"/>
            </svg>
            外链全程解耦
          </span>
        </div>
      </div>

      <!-- Right: Highlight Cards -->
      <div class="grid grid-cols-2 gap-3 lg:max-w-md lg:ml-auto animate-in delay-200">
        {heroHighlights.map((item) => (
          <div class="bg-white/15 backdrop-blur-sm rounded-2xl border border-white/20 p-5 flex flex-col gap-3 hover:bg-white/20 transition-all duration-300 hover:-translate-y-0.5">
            <span class="text-2xl" aria-hidden="true">{item.icon}</span>
            <p class="text-sm font-semibold text-white leading-snug">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

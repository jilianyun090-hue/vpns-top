---
interface Props {
  title: string;
  description: string;
  href: string;
  category: string;
  tags?: string[];
  pubDate: Date;
  updatedDate?: Date;
  featured?: boolean;
  headingLevel?: 2 | 3 | 4;
}

const {
  title, description, href, category, tags = [], pubDate, updatedDate,
  featured = false, headingLevel = 2,
} = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';

function formatDate(d: Date) {
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
}
---

<article class:list={[
  'group relative flex h-full flex-col border border-slate-200 bg-white p-6 transition-all duration-300 ease-out hover:-translate-y-1 hover:border-brand-400 hover:bg-brand-50/30 hover:shadow-[0_18px_40px_rgba(67,87,76,0.13)] focus-within:-translate-y-1 focus-within:border-brand-400 focus-within:shadow-[0_18px_40px_rgba(67,87,76,0.13)]',
  featured && 'shadow-[inset_0_2px_0_#526b5d]'
]}>
  <div class="mb-5 flex items-center justify-between gap-3">
    <a href={`/category/${encodeURIComponent(category)}/`} class="text-[10px] font-bold uppercase tracking-[0.15em] text-brand-700 hover:text-brand-900">
      {category}
    </a>
    {featured && <span class="text-[10px] font-bold uppercase tracking-[0.12em] text-amber-600">精选</span>}
  </div>

  <Heading class="text-lg font-extrabold leading-snug text-slate-950">
    <a href={href} class="hover:text-brand-600">{title}</a>
  </Heading>

  <p class="mt-3 line-clamp-3 flex-1 text-sm leading-relaxed text-slate-600">{description}</p>

  {tags.length > 0 && (
    <div class="mt-5 flex flex-wrap gap-x-3 gap-y-1">
      {tags.slice(0, 3).map((tag) => (
        <a href={`/tag/${encodeURIComponent(tag)}/`} class="text-[11px] text-slate-400 hover:text-brand-600">#{tag}</a>
      ))}
    </div>
  )}

  <div class="mt-5 flex items-center justify-between border-t border-slate-200 pt-4 font-mono text-[10px] text-slate-400">
    <time datetime={(updatedDate ?? pubDate).toISOString()}>
      {updatedDate ? `更新 ${formatDate(updatedDate)}` : formatDate(pubDate)}
    </time>
    <a href={href} class="font-sans text-xs font-bold text-slate-700 group-hover:text-brand-600">阅读全文 →</a>
  </div>
</article>

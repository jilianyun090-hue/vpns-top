---
interface Props {
  title:        string;
  description:  string;
  href:         string;
  articleCount: number;
  tags?:        string[];
  icon?:        string;
}

const { title, description, href, articleCount, tags = [], icon = '📚' } = Astro.props;
---

<a href={href} class="card card-hover p-6 flex gap-5 items-start group">
  <!-- Icon -->
  <div class="text-3xl flex-shrink-0 group-hover:scale-110 transition-transform duration-300"
       aria-hidden="true">
    {icon}
  </div>

  <!-- Content -->
  <div class="min-w-0 flex-1">
    <div class="flex items-center gap-2 mb-1.5">
      <h3 class="font-bold text-white text-base group-hover:text-brand-300 transition-colors">
        {title}
      </h3>
      <span class="badge badge-slate">{articleCount} 篇</span>
    </div>
    <p class="text-sm text-slate-400 leading-relaxed mb-3">{description}</p>
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.slice(0, 4).map((t) => (
          <span class="badge badge-brand text-xs">#{t}</span>
        ))}
      </div>
    )}
  </div>

  <!-- Arrow -->
  <svg class="w-5 h-5 text-slate-600 group-hover:text-brand-400 group-hover:translate-x-0.5 
              transition-all flex-shrink-0 mt-0.5"
       viewBox="0 0 16 16" fill="currentColor">
    <path d="M6.22 4.22a.75.75 0 0 1 1.06 0l3.5 3.5a.75.75 0 0 1 0 1.06l-3.5 3.5a.75.75 0 0 1-1.06-1.06L9.19 8 6.22 5.03a.75.75 0 0 1 0-1.06Z"/>
  </svg>
</a>

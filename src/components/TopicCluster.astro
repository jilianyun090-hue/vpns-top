---
interface Props {
  title: string;
  description: string;
  href: string;
  articleCount: number;
  tags?: string[];
  icon?: string;
}

const { title, description, href, articleCount, tags = [], icon = '集' } = Astro.props;
---

<a href={href} class="group grid grid-cols-[56px_1fr_auto] items-start gap-5 border border-slate-200 bg-white p-6 transition-all duration-300 ease-out hover:-translate-y-1 hover:border-brand-400 hover:bg-brand-50/40 hover:shadow-[0_18px_40px_rgba(67,87,76,0.13)]">
  <span class="flex h-14 w-14 items-center justify-center rounded-full border border-brand-200 bg-brand-50/60 font-serif text-xl text-brand-700 transition-all group-hover:border-brand-500 group-hover:bg-brand-100" aria-hidden="true">{icon}</span>

  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-3">
      <h3 class="text-lg font-extrabold text-slate-950 group-hover:text-brand-600">{title}</h3>
      <span class="font-mono text-[10px] font-semibold uppercase tracking-wider text-slate-400">{articleCount} articles</span>
    </div>
    <p class="mt-2 text-sm leading-relaxed text-slate-600">{description}</p>
    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-x-3 gap-y-1">
        {tags.slice(0, 4).map((tag) => <span class="text-[11px] text-slate-400">#{tag}</span>)}
      </div>
    )}
  </div>

  <span class="mt-1 text-slate-300 transition-all group-hover:translate-x-1 group-hover:text-brand-600" aria-hidden="true">→</span>
</a>

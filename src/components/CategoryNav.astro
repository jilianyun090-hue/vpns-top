---
import { categories } from '../data/categories';

interface Props {
  activeCategory?: string;
  activeTag?:      string;
  showTags?:       boolean;
  tags?:           string[];
}

const { activeCategory, activeTag, showTags = false, tags = [] } = Astro.props;
---

<div class="flex flex-col gap-4">
  <!-- Category filter -->
  <div class="flex flex-wrap gap-2">
    <a
      href="/blog/"
      class:list={[
        'badge text-xs px-3 py-1.5 rounded-lg font-medium transition-all duration-150',
        !activeCategory
          ? 'bg-brand-600 text-white border border-brand-500 shadow-sm'
          : 'badge-slate hover:text-slate-900 hover:bg-slate-200'
      ]}
    >
      全部
    </a>
    {categories.map((cat) => (
      <a
        href={`/category/${cat.slug}/`}
        class:list={[
          'badge text-xs px-3 py-1.5 rounded-lg font-medium transition-all duration-150 flex items-center gap-1',
          activeCategory === cat.slug
            ? 'bg-brand-600 text-white border border-brand-500 shadow-sm'
            : 'badge-slate hover:text-slate-900 hover:bg-slate-200'
        ]}
      >
        <span aria-hidden="true">{cat.icon}</span>
        {cat.label}
      </a>
    ))}
  </div>

  <!-- Tag filter (optional) -->
  {showTags && tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <a
          href={`/tag/${tag}/`}
          class:list={[
            'text-xs px-2.5 py-1 rounded-full border transition-colors',
            activeTag === tag
              ? 'border-brand-500 text-brand-600 bg-brand-50 font-semibold'
              : 'border-slate-200 text-slate-600 hover:text-brand-600 hover:border-brand-300'
          ]}
        >
          #{tag}
        </a>
      ))}
    </div>
  )}
</div>

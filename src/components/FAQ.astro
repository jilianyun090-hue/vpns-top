---
// FAQ accordion — pure native <details>/<summary>, zero JavaScript
interface FAQItem {
  question: string;
  answer:   string;
}

interface Props {
  items:   FAQItem[];
  schema?: boolean; // emit FAQPage JSON-LD
}

const { items, schema = true } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<div class="space-y-3">
  {items.map((item) => (
    <details class="group card border border-white/5 overflow-hidden">
      <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer
                       font-semibold text-slate-200 hover:text-white list-none
                       transition-colors duration-150">
        <span class="text-sm sm:text-base">{item.question}</span>
        <!-- Chevron icon, rotates when open -->
        <svg class="w-5 h-5 text-slate-500 flex-shrink-0 transition-transform duration-200
                    group-open:rotate-180"
             viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
        </svg>
      </summary>
      <div class="px-5 pb-5 pt-1 text-sm text-slate-400 leading-relaxed border-t border-white/5">
        {item.answer}
      </div>
    </details>
  ))}
</div>

{schema && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
)}

---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  schema?: boolean;
}

const { items, schema = true } = Astro.props;
const validItems = items.filter((item) => item.question.trim() && item.answer.trim());

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: validItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
const serializedFaqSchema = JSON.stringify(faqSchema).replace(/</g, '\\u003c');
---

<div class="divide-y divide-slate-200 border-y border-slate-200">
  {validItems.map((item, index) => (
    <details class="group">
      <summary class="grid cursor-pointer list-none grid-cols-[36px_1fr_auto] items-center gap-3 py-5 text-slate-900 transition-colors hover:text-brand-600">
        <span class="font-mono text-[10px] text-slate-400">{String(index + 1).padStart(2, '0')}</span>
        <span class="text-sm font-bold sm:text-base">{item.question}</span>
        <span class="flex h-7 w-7 items-center justify-center border border-slate-200 text-slate-500 transition-all group-open:rotate-45 group-open:border-brand-300 group-open:text-brand-600" aria-hidden="true">+</span>
      </summary>
      <div class="pb-6 pl-[49px] pr-10 text-sm leading-relaxed text-slate-600">{item.answer}</div>
    </details>
  ))}
</div>

{schema && validItems.length > 0 && (
  <script type="application/ld+json" is:inline set:html={serializedFaqSchema} />
)}

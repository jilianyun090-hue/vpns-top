---
interface Props {
  title:    string;
  subtitle?: string;
  centered?: boolean;
  tag?:     string;
  headingLevel?: 1 | 2 | 3;
  id?:      string;
}

const {
  title,
  subtitle,
  centered = false,
  tag,
  headingLevel = 2,
  id,
} = Astro.props;
const Heading = `h${headingLevel}` as 'h1' | 'h2' | 'h3';
---

<div class:list={['mb-9', centered && 'text-center']}>
  {tag && (
    <span class="mb-4 inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.16em] text-brand-700">
      <span class="h-px w-5 bg-brand-600" aria-hidden="true"></span>
      {tag}
    </span>
  )}
  <Heading id={id} class="text-3xl font-extrabold leading-tight text-slate-950 sm:text-4xl">
    {title}
  </Heading>
  {subtitle && (
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600" class:list={[centered && 'mx-auto']}>
      {subtitle}
    </p>
  )}
</div>

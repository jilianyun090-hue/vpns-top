---
interface Props {
  title:    string;
  subtitle?: string;
  centered?: boolean;
  tag?:     string;
  headingLevel?: 1 | 2 | 3;
  id?:      string;
}

const {
  title,
  subtitle,
  centered = false,
  tag,
  headingLevel = 2,
  id,
} = Astro.props;
const Heading = `h${headingLevel}` as 'h1' | 'h2' | 'h3';
---

<div class:list={['mb-10', centered && 'text-center']}>
  {tag && (
    <span class="badge badge-brand mb-3">{tag}</span>
  )}
  <Heading id={id} class="text-2xl sm:text-3xl font-bold text-slate-900 leading-tight">
    {title}
  </Heading>
  {subtitle && (
    <p class="mt-3 text-slate-600 max-w-2xl leading-relaxed" class:list={[centered && 'mx-auto']}>
      {subtitle}
    </p>
  )}
</div>

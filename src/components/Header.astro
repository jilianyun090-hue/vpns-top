---
import { SITE } from '../data/site';
import { mainNav } from '../data/nav';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const normalizePath = (href: string) => href.replace(/\/+$/, '') || '/';
const pathMatches = (href: string) => {
  const path = normalizePath(href);
  if (path.includes('#')) return currentPath === normalizePath(path.split('#')[0]);
  return currentPath === path || (path !== '/' && currentPath.startsWith(`${path}/`));
};
const isNavActive = (item: (typeof mainNav)[number]) =>
  pathMatches(item.href) || Boolean(item.children?.some((child) => pathMatches(child.href)));
---

<header class="sticky top-0 z-50 border-b border-stone-300/70 bg-[#f7f4ec]/90 text-ink shadow-[0_1px_18px_rgba(42,48,43,0.04)] backdrop-blur-xl">
  <div class="container-xl">
    <div class="flex h-[76px] items-center justify-between">
      <a href="/" class="group flex items-center gap-3.5" aria-label={SITE.name}>
        <span class="relative flex h-10 w-10 items-center justify-center rounded-full border border-ink/30 font-serif text-lg font-bold text-ink transition-all duration-300 group-hover:border-brand-600 group-hover:text-brand-700">
          山
          <span class="absolute -bottom-1 -right-1 h-3 w-3 rounded-full border-2 border-[#f7f4ec] bg-brand-600"></span>
        </span>
        <span>
          <span class="block font-serif text-[18px] font-bold tracking-[0.06em] text-ink">VPNs Top</span>
          <span class="hidden text-[9px] font-medium tracking-[0.2em] text-stone-500 sm:block">独立评测 · 清醒选择</span>
        </span>
      </a>

      <nav class="hidden items-center gap-0.5 lg:flex" aria-label="主导航">
        {mainNav.map((item, index) => (
          item.children ? (
            <div class="group relative">
              <button
                type="button"
                class:list={[
                  'flex items-center gap-1.5 px-3 py-3 text-[13px] font-medium tracking-wide transition-colors',
                  isNavActive(item) ? 'text-brand-700' : 'text-stone-600 hover:text-ink'
                ]}
                aria-haspopup="true"
                aria-current={isNavActive(item) ? 'page' : undefined}
              >
                {item.label}
                <svg class="h-3 w-3 opacity-50 transition-transform duration-300 group-hover:rotate-180" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z"/>
                </svg>
                <span class:list={[
                  'absolute bottom-2 h-px bg-brand-600 transition-all duration-300',
                  isNavActive(item) ? 'inset-x-3' : 'left-1/2 right-1/2 group-hover:inset-x-3'
                ]}></span>
              </button>

              <div class:list={[
                'invisible absolute top-full z-50 mt-0 w-[540px] translate-y-2 border border-stone-300/80 bg-[#fbf8f0]/95 p-3 opacity-0 shadow-[0_24px_70px_rgba(42,48,43,0.16)] backdrop-blur-xl transition-all duration-300 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100',
                index >= 2 ? 'right-0' : 'left-0'
              ]}>
                <div class="flex items-end justify-between border-b border-stone-200 px-3 pb-3 pt-2">
                  <div>
                    <p class="font-serif text-base font-bold text-ink">{item.label}</p>
                    <p class="mt-1 text-[11px] text-stone-500">{item.description}</p>
                  </div>
                  <span class="font-serif text-2xl text-brand-300">水</span>
                </div>

                <div class="grid grid-cols-2 gap-1 pt-2">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      aria-current={pathMatches(child.href) ? 'page' : undefined}
                      class:list={[
                        'group/item grid grid-cols-[34px_1fr] gap-3 px-3 py-3 transition-colors duration-200',
                        pathMatches(child.href)
                          ? 'bg-brand-50 text-brand-800'
                          : 'text-stone-600 hover:bg-[#f0eee6] hover:text-ink'
                      ]}
                    >
                      <span class="flex h-8 w-8 items-center justify-center rounded-full border border-brand-200 font-serif text-sm text-brand-700 transition-colors group-hover/item:border-brand-500 group-hover/item:bg-brand-100">
                        {child.mark}
                      </span>
                      <span>
                        <span class="block text-sm font-semibold">{child.label}</span>
                        <span class="mt-0.5 block text-[11px] leading-relaxed text-stone-500">{child.description}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              aria-current={pathMatches(item.href) ? 'page' : undefined}
              class:list={[
                'relative px-3 py-3 text-[13px] font-medium tracking-wide transition-colors',
                pathMatches(item.href) ? 'text-brand-700' : 'text-stone-600 hover:text-ink'
              ]}
            >
              {item.label}
            </a>
          )
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <a href="/compare/" class="hidden border border-brand-700 bg-brand-700 px-4 py-2.5 text-xs font-semibold tracking-wide text-[#fbf8f0] transition-all hover:bg-brand-800 md:inline-flex">
          开始选购
          <span class="ml-2" aria-hidden="true">→</span>
        </a>

        <details class="group lg:hidden">
          <summary class="list-none border border-stone-300 bg-[#fbf8f0]/70 p-2.5 text-stone-600 transition-colors hover:border-brand-400 hover:text-brand-700" aria-label="展开菜单">
            <svg class="h-5 w-5 group-open:hidden" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M2 4.75A.75.75 0 0 1 2.75 4h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 4.75Zm0 10.5a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75ZM2 10a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 10Z" clip-rule="evenodd"/>
            </svg>
            <svg class="hidden h-5 w-5 group-open:block" viewBox="0 0 20 20" fill="currentColor">
              <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/>
            </svg>
          </summary>

          <div class="animate-in absolute left-0 right-0 top-[77px] max-h-[calc(100vh-77px)] overflow-y-auto border-b border-stone-300 bg-[#f7f4ec]/[0.98] px-5 py-5 shadow-2xl">
            <div class="mx-auto max-w-2xl">
              {mainNav.map((item) => (
                <div class="border-b border-stone-200 py-2 last:border-0">
                  <a href={item.href} class="block py-2 font-serif text-base font-bold text-ink">{item.label}</a>
                  {item.children && (
                    <div class="grid grid-cols-2 gap-2 pb-3">
                      {item.children.map((child) => (
                        <a href={child.href} class="flex items-center gap-2 py-2 text-xs text-stone-600 hover:text-brand-700">
                          <span class="font-serif text-brand-600">{child.mark}</span>
                          {child.label}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>

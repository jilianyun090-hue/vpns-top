---
import { SITE } from '../data/site';
import { mainNav } from '../data/nav';
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-xl border-b border-slate-200 shadow-sm">
  <div class="container-xl">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group" aria-label={SITE.name}>
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 
                    flex items-center justify-center text-white font-black text-sm
                    shadow-lg shadow-brand-200 group-hover:shadow-brand-300 transition-shadow">
          V
        </div>
        <span class="font-black text-lg tracking-tight">
          <span class="text-slate-900">VPNs</span><span class="text-brand-600">Top</span>
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1" aria-label="主导航">
        {mainNav.map((item) => (
          item.children ? (
            <div class="relative group">
              <button
                class="flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium
                       text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-all duration-150"
                aria-haspopup="true"
              >
                {item.label}
                <svg class="w-3.5 h-3.5 opacity-60 group-hover:rotate-180 transition-transform duration-200"
                     viewBox="0 0 16 16" fill="currentColor">
                  <path d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z"/>
                </svg>
              </button>
              <!-- Dropdown -->
              <div class="absolute top-full left-0 mt-1 w-44 bg-white rounded-xl border border-slate-200
                          shadow-xl shadow-slate-200/80 opacity-0 invisible group-hover:opacity-100 group-hover:visible
                          transition-all duration-200 translate-y-1 group-hover:translate-y-0 z-50">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class="block px-4 py-2.5 text-sm text-slate-600 hover:text-slate-900 hover:bg-slate-50
                           first:rounded-t-xl last:rounded-b-xl transition-colors"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class="px-3 py-2 rounded-lg text-sm font-medium text-slate-600
                     hover:text-slate-900 hover:bg-slate-100 transition-all duration-150"
            >
              {item.label}
            </a>
          )
        ))}
      </nav>

      <!-- CTA + Mobile Toggle -->
      <div class="flex items-center gap-2">
        <a href="/brands/" class="hidden sm:inline-flex btn-primary text-xs px-4 py-2">
          品牌库
          <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor">
            <path d="M6.22 4.22a.75.75 0 0 1 1.06 0l3.5 3.5a.75.75 0 0 1 0 1.06l-3.5 3.5a.75.75 0 0 1-1.06-1.06L9.19 8 6.22 5.03a.75.75 0 0 1 0-1.06Z"/>
          </svg>
        </a>

        <!-- Mobile menu toggle (pure CSS) -->
        <details class="md:hidden group">
          <summary class="list-none cursor-pointer p-2 rounded-lg hover:bg-slate-100 transition-colors"
                   aria-label="展开菜单">
            <svg class="w-5 h-5 text-slate-600 group-open:hidden" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M2 4.75A.75.75 0 0 1 2.75 4h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 4.75Zm0 10.5a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75ZM2 10a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 10Z" clip-rule="evenodd"/>
            </svg>
            <svg class="w-5 h-5 text-slate-600 hidden group-open:block" viewBox="0 0 20 20" fill="currentColor">
              <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/>
            </svg>
          </summary>

          <!-- Mobile Dropdown -->
          <div class="absolute left-0 right-0 top-16 bg-white border-b border-slate-200
                      shadow-xl animate-in py-4 px-4">
            {mainNav.map((item) => (
              <div>
                <a href={item.href}
                   class="block py-2.5 px-3 text-sm font-medium text-slate-700 
                          hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-colors">
                  {item.label}
                </a>
                {item.children && (
                  <div class="ml-4 border-l border-slate-200 pl-3 mb-1">
                    {item.children.map((child) => (
                      <a href={child.href}
                         class="block py-2 text-xs text-slate-500 hover:text-slate-800 transition-colors">
                        {child.label}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            ))}
            <div class="pt-3 border-t border-slate-200 mt-2">
              <a href="/brands/" class="btn-primary w-full justify-center">查看品牌库</a>
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>

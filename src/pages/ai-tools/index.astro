---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const aiPosts = (await getCollection('blog', ({ data }) => !data.draft && data.category === 'ai'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 10);

const tools = [
  { mark: '喵', name: '黑喵', href: '/go/heimao-ai/', description: '第三方 AI 模型中转服务入口。' },
  { mark: '快', name: '快AI', href: '/go/kuai-ai/', description: '提供 AI API 与模型中转注册入口。' },
  { mark: '狐', name: '科技狐', href: '/go/keji-hu/', description: '第三方 AI 模型中转与注册入口。' },
];
---

<BaseLayout title="AI 工具导航：黑喵、快AI与科技狐" description="集中整理黑喵、快AI、科技狐三个第三方AI模型中转服务入口，并通过站内跳转页统一管理外链。">
  <div class="container-xl max-w-5xl py-10 lg:py-14">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: 'AI 工具' }]} />
    <SectionTitle headingLevel={1} title="AI 工具" subtitle="三个 AI 中转站集中放在独立页面中，不再与客户端教程或首页内容混合。" tag="AI TOOLS" />

    <div class="grid gap-4 md:grid-cols-3">
      {tools.map((tool) => (
        <a href={tool.href} class="group flex min-h-[250px] flex-col border border-stone-300/80 bg-[#fbf8f0]/80 p-7 transition-all duration-300 hover:-translate-y-1 hover:border-brand-500 hover:bg-[#fffdf7] hover:shadow-[0_22px_50px_rgba(62,77,68,0.13)]">
          <span class="flex h-12 w-12 items-center justify-center rounded-full border border-brand-300 font-serif text-lg text-brand-700 group-hover:border-brand-600 group-hover:bg-brand-50">{tool.mark}</span>
          <h2 class="mt-8 text-2xl font-bold text-ink group-hover:text-brand-800">{tool.name}</h2>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-stone-500">{tool.description}</p>
          <span class="mt-8 border-t border-stone-300/70 pt-5 text-sm font-semibold text-brand-700">访问服务 →</span>
        </a>
      ))}
    </div>

    <aside class="mt-10 border-l-2 border-brand-500 bg-[#efebe1]/65 px-6 py-5 text-sm leading-relaxed text-stone-600">
      <strong class="text-ink">使用提示：</strong>
      以上均为第三方服务，与本站不存在隶属关系。请在注册或付费前自行核验服务条款、价格、隐私政策与可用性；外链统一通过本站 <code>/go/</code> 跳转页管理。
    </aside>

    <section class="pt-14" aria-labelledby="ai-guides-heading">
      <div class="flex items-end justify-between gap-6">
        <SectionTitle id="ai-guides-heading" title="AI 节点与使用指南" subtitle="围绕地区选择、IP 质量、登录异常、API 中转和隐私风险整理的独立文章。" tag="指南" />
        <a href="/category/ai/" class="btn-secondary mb-9 hidden text-sm sm:inline-flex">全部文章 →</a>
      </div>
      {aiPosts.length > 0 ? (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {aiPosts.map((post) => (
            <ArticleCard title={post.data.title} description={post.data.description} href={`/blog/${post.slug}/`} category={post.data.category} tags={post.data.tags} pubDate={post.data.pubDate} updatedDate={post.data.updatedDate} featured={post.data.featured} />
          ))}
        </div>
      ) : (
        <p class="border border-stone-300/70 bg-[#fbf8f0]/70 p-8 text-sm text-stone-500">AI 节点指南正在整理中。</p>
      )}
    </section>
  </div>
</BaseLayout>

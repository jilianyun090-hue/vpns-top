---
import LandingLayout    from '../../layouts/LandingLayout.astro';
import ComparisonTable  from '../../components/ComparisonTable.astro';
import SectionTitle     from '../../components/SectionTitle.astro';
import { getCollection } from 'astro:content';

const allBrands = await getCollection('brands');
const sorted = allBrands.sort((a, b) => b.data.rating - a.data.rating);

// Build comparison table data
const tableHeaders = ['品牌名称', '综合评分', '最低价格', 'Trojan/SS', 'VMess/VLESS', '专线过境', 'Netflix解锁', 'Disney+解锁', 'ChatGPT AI'];

const tableRows = sorted.map((b) => [
  b.data.name,
  `${b.data.rating.toFixed(1)} / 10`,
  b.data.minPrice !== undefined ? (b.data.minPrice === 1.0 ? '¥1.0/次起' : `¥${b.data.minPrice.toFixed(1)}/月`) : '—',
  b.data.nodeTypes.some((t) => t.includes('SS') || t.includes('Trojan') || t.includes('Shadowsocks')),
  b.data.nodeTypes.some((t) => t.includes('VMess') || t.includes('V2Ray') || t.includes('VLESS')),
  b.data.nodeTypes.some((t) => t.includes('IPLC') || t.includes('IEPL') || t.includes('专线')),
  b.data.streamingSupport.some((s) => s.includes('Netflix')),
  b.data.streamingSupport.some((s) => s.includes('Disney')),
  b.data.streamingSupport.some((s) => s.includes('ChatGPT')),
]);
---

<LandingLayout
  title="2026 机场横向对比矩阵 - 极连云 / 光年梯 / 鲲鹏加速等 30+ 品牌测评"
  description="多维度横向矩阵对比主流机场品牌，包含 IEPL/IPLC 专线、协议支持、流媒体与 ChatGPT 解锁、价格与综合评分。"
  breadcrumbs={[
    { label: '首页', href: '/' },
    { label: '横向对比' },
  ]}
>
  <div slot="header" class="mb-10">
    <div class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-brand-100 text-brand-700 mb-3">
      数据每周同步实测
    </div>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 mb-4 tracking-tight">
      机场横向对比矩阵
    </h1>
    <p class="text-slate-600 leading-relaxed max-w-3xl text-base sm:text-lg">
      基于独立测速数据与全平台连通性测试，综合 12 个维度对 {sorted.length} 家主流机场进行量化评分与参数对比。
      帮您一目了然筛选最优网络加速方案。
    </p>
  </div>

  <!-- Top 3 Quick Highlights Card -->
  <div class="grid sm:grid-cols-3 gap-4 mb-10">
    {sorted.slice(0, 3).map((brand, idx) => (
      <div class="bg-gradient-to-br from-amber-500/10 via-white to-white border border-amber-300/80 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-black px-2.5 py-0.5 rounded-full bg-amber-500 text-white">
              TOP {idx + 1}
            </span>
            <span class="text-xl font-black text-amber-500">{brand.data.rating.toFixed(1)}</span>
          </div>
          <h3 class="font-extrabold text-slate-900 text-lg mb-1">{brand.data.name}</h3>
          <p class="text-xs text-slate-500 line-clamp-2">{brand.data.tagline}</p>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
          <span class="text-slate-500">
            {brand.data.minPrice ? `¥${brand.data.minPrice.toFixed(1)}起` : '实时优惠'}
          </span>
          <a href={`/brands/${brand.slug}/`} class="font-bold text-amber-600 hover:text-amber-700">
            查看详情 →
          </a>
        </div>
      </div>
    ))}
  </div>

  <SectionTitle
    title="全量参数对比大表"
    subtitle="包含专线类型、协议类型、流媒体与 AI 解锁情况（支持横向滑动）"
    tag="对比"
  />

  {sorted.length > 0 ? (
    <div class="bg-white rounded-2xl shadow-xs">
      <ComparisonTable
        headers={tableHeaders}
        rows={tableRows}
        caption={`共 ${sorted.length} 家品牌 · 数据实时更新于 ${new Date().toLocaleDateString('zh-CN')}`}
      />
    </div>
  ) : (
    <p class="text-slate-500 text-center py-20">品牌数据收录中，敬请期待。</p>
  )}

  <!-- Legend -->
  <div class="mt-6 flex flex-wrap gap-6 p-4 rounded-xl bg-slate-50 border border-slate-200/80 text-xs text-slate-600">
    <span class="flex items-center gap-1.5 font-medium"><strong class="text-emerald-600">✅</strong> = 完全支持且原生解锁</span>
    <span class="flex items-center gap-1.5 font-medium"><strong class="text-red-500">❌</strong> = 不支持 / 未解锁</span>
    <span class="flex items-center gap-1.5 font-medium"><strong class="text-slate-400">—</strong> = 数据待补充或按需配置</span>
  </div>
</LandingLayout>

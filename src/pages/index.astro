---
import BaseLayout     from '../layouts/BaseLayout.astro';
import Hero           from '../components/Hero.astro';
import StatsStrip     from '../components/StatsStrip.astro';
import SectionTitle   from '../components/SectionTitle.astro';
import FeatureCard    from '../components/FeatureCard.astro';
import ArticleCard    from '../components/ArticleCard.astro';
import BrandCard      from '../components/BrandCard.astro';
import TopicCluster   from '../components/TopicCluster.astro';
import CTASection     from '../components/CTASection.astro';
import NewsletterBox  from '../components/NewsletterBox.astro';
import FAQ            from '../components/FAQ.astro';

import { getCollection }  from 'astro:content';
import { features, faqs } from '../data/homepage';

// Fetch content
const allPosts  = await getCollection('blog',   ({ data }) => !data.draft);
const allBrands = await getCollection('brands');
const allTopics = await getCollection('topics', ({ data }) => !data.draft);

// Sort
const latestPosts    = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 6);
const featuredBrands = allBrands.filter((b) => b.data.featured).sort((a, b) => b.data.rating - a.data.rating).slice(0, 4);
const topTopics      = allTopics.sort((a, b) => a.data.order - b.data.order).slice(0, 4);

const priorityGuides = [
  {
    title: '2026 梯子排行榜与机场节点选择',
    description: '按线路、晚高峰表现、节点倍率与月付风险理解梯子排行。',
    href: '/blog/ladder-ranking-airport-recommendation-2026/',
  },
  {
    title: '稳定梯子与机场 VPN 推荐',
    description: '从可用性、丢包、线路冗余和售后判断长期稳定性。',
    href: '/blog/stable-ladder-vpn-guide-2026/',
  },
  {
    title: '瞬云机场评测与购买前核验',
    description: '了解瞬云的节点、线路、套餐与适用场景，并核对最新信息。',
    href: '/blog/shunyun-review-2026/',
  },
  {
    title: '机场推荐与性价比选择指南',
    description: '按预算、设备、流量和使用场景筛选适合自己的 VPN 机场。',
    href: '/blog/airport-recommendations-2026/',
  },
];
---

<BaseLayout
  title="2026年机场推荐：高性价比VPN机场、稳定梯子排行与节点评测"
  description="【2026更新】聚焦机场推荐、VPN机场与稳定梯子评测，对比高性价比机场的IEPL/IPLC线路、机场节点、速度、流媒体解锁与价格，并提供Clash等客户端使用教程。"
>
  <!-- ① Hero 首屏 -->
  <Hero />

  <!-- ② 信任背书数据条 -->
  <StatsStrip />

  <!-- ③ 精选推荐品牌 (极连云第一 光年梯第二 鲲鹏加速第三 飞猫云第四) -->
  {featuredBrands.length > 0 && (
    <section id="featured-brands" class="section container-xl py-12 lg:py-16">
      <div class="flex items-end justify-between mb-8">
        <SectionTitle
          title="2026 精选翻墙机场推荐榜单"
          subtitle="综合 12 维度严苛实测，极连云、光年梯、鲲鹏加速领跑高性价比梯子排行榜。"
          tag="TOP 推荐"
        />
        <a href="/brands/" class="btn-secondary text-sm hidden sm:inline-flex">查看完整品牌库 →</a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {featuredBrands.map((brand) => (
          <BrandCard
            name={brand.data.name}
            slug={brand.slug}
            rating={brand.data.rating}
            tagline={brand.data.tagline}
            nodeTypes={brand.data.nodeTypes}
            streamingSupport={brand.data.streamingSupport}
            minPrice={brand.data.minPrice}
            referralId={brand.data.referralId}
            tags={brand.data.tags}
            featured={brand.data.featured}
          />
        ))}
      </div>
    </section>
  )}

  <!-- ④ SEO 核心长文科普（参考二毛博客结构：机场、VPN、梯子、魔法、科学上网） -->
  <section class="section bg-slate-50/80 border-y border-slate-200/80">
    <div class="container-xl max-w-5xl">
      <SectionTitle
        title="科学上网与翻墙机场选购指南"
        subtitle="系统梳理 2026 年机场推荐、VPN 测评、魔法梯子原理与防坑技巧。"
        centered
        tag="核心指南"
      />

      <div class="mt-10 grid gap-8 text-slate-700 text-sm leading-relaxed">
        <!-- Pillar Box 1 -->
        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-xs">
          <h3 class="text-xl font-extrabold text-slate-900 mb-3">
            什么是翻墙机场？“机场”与传统 VPN 有何区别？
          </h3>
          <p class="mb-3">
            在网络科学上网领域，<strong>“机场”</strong> 是指基于 <em>Shadowsocks (SS)、Trojan、VMess、VLESS 或 Hysteria 2</em> 协议提供网络代理服务的接入平台。因为早期广泛使用的客户端程序（ShadowsocksR、Clash）图标类似于纸飞机，故被网友形象地称为“机场”。
          </p>
          <p>
            与 ExpressVPN、NordVPN 等传统商业 <strong>VPN</strong> 相比，机场的主要优势在于：<strong>支持企业级物理专线（IEPL/IPLC）过境</strong>，延迟更低、丢包率接近零、且针对 GFW 的深度包检测（DPI）具备极强的抗封锁能力。
          </p>
        </div>

        <!-- Pillar Box 2 -->
        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-xs">
          <h3 class="text-xl font-extrabold text-slate-900 mb-3">
            如何挑选便宜好用的魔法梯子与科学上网机场？
          </h3>
          <ul class="list-disc pl-5 space-y-2 text-slate-600">
            <li>
              <strong class="text-slate-900">看线路类型（专线 vs 中转）</strong>：优先选择全 IEPL / IPLC 专线过境服务商。例如本站推荐的 <a href="/brands/jilian-yun/" class="text-amber-600 font-bold hover:underline">极连云</a> 与 <a href="/brands/guangnian-ti/" class="text-amber-600 font-bold hover:underline">光年梯</a>，晚高峰期满速不降速。
            </li>
            <li>
              <strong class="text-slate-900">看扣费倍率与透明度</strong>：避开隐藏倍率陷阱。例如 <a href="/brands/kunpeng-jiasu/" class="text-amber-600 font-bold hover:underline">鲲鹏加速</a> 承诺全站节点统一 1.0 倍率，并提供 ¥1.00 低门槛体验包。
            </li>
            <li>
              <strong class="text-slate-900">看流媒体与 AI 工具解锁</strong>：确认节点是否提供纯净原生 IP，能否无缝解锁 ChatGPT、Claude、Netflix 4K 及 YouTube Premium。
            </li>
            <li>
              <strong class="text-slate-900">看客户端兼容性</strong>：确保支持 Clash Verge Rev、Shadowrocket (小火箭)、Sing-box 及 v2rayN 一键订阅导入。
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Bing 高曝光关键词对应的核心内容入口 -->
  <section class="section container-xl" aria-labelledby="priority-guides-heading">
    <SectionTitle
      id="priority-guides-heading"
      title="热门机场与梯子选购指南"
      subtitle="围绕梯子排行榜、稳定机场 VPN、机场节点与瞬云机场等高频问题，直达对应深度文章。"
      centered
      tag="热门搜索"
    />
    <nav class="mt-8 grid md:grid-cols-2 gap-x-10 gap-y-2" aria-label="热门搜索指南">
      {priorityGuides.map((guide) => (
        <a
          href={guide.href}
          class="group flex items-start justify-between gap-5 border-b border-slate-200 py-5"
        >
          <span>
            <span class="block text-base font-extrabold text-slate-900 group-hover:text-brand-600 transition-colors">
              {guide.title}
            </span>
            <span class="mt-1 block text-sm leading-relaxed text-slate-600">
              {guide.description}
            </span>
          </span>
          <span class="mt-0.5 shrink-0 text-brand-600" aria-hidden="true">→</span>
        </a>
      ))}
    </nav>
  </section>

  <!-- ⑤ 核心栏目导航 -->
  <section class="section container-xl">
    <SectionTitle
      title="一站式评测与教程导航"
      subtitle="覆盖机场评测、VPN对比、故障排查与选购决策全品类。"
      centered
      tag="栏目矩阵"
    />
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-8">
      {features.map((f) => (
        <FeatureCard
          icon={f.icon}
          title={f.title}
          description={f.description}
          href={f.href}
          cta={f.cta}
        />
      ))}
    </div>
  </section>

  <!-- ⑥ 最新评测文章 -->
  {latestPosts.length > 0 && (
    <section class="section bg-slate-50/80 border-y border-slate-200/80">
      <div class="container-xl">
        <div class="flex items-end justify-between mb-8">
          <SectionTitle
            title="最新评测与魔法梯子教程"
            subtitle="最近发布与更新的机场深度测评、VPN 比较与科学上网指南。"
            tag="最新动态"
          />
          <a href="/blog/" class="btn-secondary text-sm hidden sm:inline-flex">查看全部文章 →</a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {latestPosts.map((post) => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              href={`/blog/${post.slug}/`}
              category={post.data.category}
              tags={post.data.tags}
              pubDate={post.data.pubDate}
              updatedDate={post.data.updatedDate}
              featured={post.data.featured}
            />
          ))}
        </div>
        <div class="mt-6 text-center sm:hidden">
          <a href="/blog/" class="btn-secondary text-sm">查看全部文章</a>
        </div>
      </div>
    </section>
  )}

  <!-- ⑦ 热门专题 -->
  {topTopics.length > 0 && (
    <section class="section container-xl">
      <SectionTitle
        title="热门专题集群"
        subtitle="系统梳理网络出海知识，从新手入门到进阶避坑一网打尽。"
        centered
        tag="专题集群"
      />
      <div class="grid sm:grid-cols-2 gap-5 mt-8">
        {topTopics.map((topic) => (
          <TopicCluster
            title={topic.data.title}
            description={topic.data.description}
            href={`/topics/${topic.slug}/`}
            articleCount={topic.data.articleCount}
            tags={topic.data.tags}
          />
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/topics/" class="btn-secondary text-sm">探索所有专题集群</a>
      </div>
    </section>
  )}

  <!-- ⑧ 常见问题 -->
  <section class="section container-xl max-w-3xl mx-auto">
    <SectionTitle
      title="常见问题解答 (FAQ)"
      subtitle="关于机场推荐、VPN 选择与本站测评方法论的解答。"
      centered
    />
    <FAQ items={[...faqs]} />
  </section>

  <!-- ⑨ CTA + Newsletter -->
  <section class="section container-xl">
    <CTASection />
    <div class="mt-6 max-w-2xl mx-auto">
      <NewsletterBox />
    </div>
  </section>
</BaseLayout>

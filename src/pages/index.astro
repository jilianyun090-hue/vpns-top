---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import HubCard from '../components/HubCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import BrandCard from '../components/BrandCard.astro';
import { getCollection } from 'astro:content';
import { homeSections } from '../data/homepage';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const allBrands = await getCollection('brands');
const featuredBrands = allBrands
  .filter((brand) => brand.data.featured)
  .sort((a, b) => b.data.rating - a.data.rating)
  .slice(0, 4);
---

<BaseLayout
  title="2026年机场推荐：高性价比VPN机场、稳定梯子排行与节点评测"
  description="【2026更新】聚焦机场推荐、VPN机场与稳定梯子评测，对比高性价比机场的IEPL/IPLC线路、机场节点、速度、流媒体解锁与价格，并提供Clash等客户端使用教程。"
>
  <Hero />

  <section class="container-xl py-12 lg:py-16" aria-labelledby="home-sections">
    <SectionTitle
      id="home-sections"
      title="按目的进入独立栏目"
      subtitle="首页不再承载所有长文和专题，只保留站点地图式入口。"
      tag="栏目"
    />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {homeSections.map((item) => (
        <HubCard mark={item.icon} title={item.title} description={item.description} href={item.href} />
      ))}
    </div>
  </section>

  {featuredBrands.length > 0 && (
    <section id="featured-brands" class="border-y border-stone-300/70 bg-[#efebe1]/38">
      <div class="container-xl py-12 lg:py-16">
        <div class="flex items-end justify-between gap-6">
          <SectionTitle title="精选品牌" subtitle="首页仅展示少量入口，完整评分与资料请进入评测栏目。" tag="品牌" />
          <a href="/reviews/" class="btn-secondary mb-9 hidden text-sm sm:inline-flex">进入评测与排行 →</a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {featuredBrands.map((brand) => (
            <BrandCard
              name={brand.data.name}
              slug={brand.slug}
              rating={brand.data.rating}
              tagline={brand.data.tagline}
              nodeTypes={brand.data.nodeTypes}
              streamingSupport={brand.data.streamingSupport}
              minPrice={brand.data.minPrice}
              referralId={brand.data.referralId}
              tags={brand.data.tags}
              featured={brand.data.featured}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {latestPosts.length > 0 && (
    <section class="container-xl py-12 lg:py-16" aria-labelledby="home-latest-posts">
      <div class="flex items-end justify-between gap-6">
        <SectionTitle id="home-latest-posts" title="最近更新" subtitle="保留三篇最新内容作为更新窗口，全部文章在博客索引中查看。" tag="文章" />
        <a href="/blog/" class="btn-secondary mb-9 hidden text-sm sm:inline-flex">查看全部文章 →</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {latestPosts.map((post) => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            href={`/blog/${post.slug}/`}
            category={post.data.category}
            tags={post.data.tags}
            pubDate={post.data.pubDate}
            updatedDate={post.data.updatedDate}
            featured={post.data.featured}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

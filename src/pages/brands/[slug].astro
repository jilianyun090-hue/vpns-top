---
import LandingLayout from '../../layouts/LandingLayout.astro';
import NewsletterBox from '../../components/NewsletterBox.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const brands = await getCollection('brands');
  return brands.map((brand) => ({
    params: { slug: brand.slug },
    props:  { brand },
  }));
}) satisfies GetStaticPaths;

const { brand } = Astro.props;
const { Content } = await brand.render();

// Fetch related posts that mention this brand or match tags
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const relatedPosts = allPosts.filter((post) =>
  post.data.referralId === brand.data.referralId ||
  post.data.tags.some((t) => brand.data.tags.includes(t)) ||
  post.data.title.includes(brand.data.name)
).slice(0, 3);

const fullStars  = Math.floor(brand.data.rating / 2);
const halfStar   = brand.data.rating % 2 >= 1;
const emptyStars = 5 - fullStars - (halfStar ? 1 : 0);
---

<LandingLayout
  title={`${brand.data.name} 评测 - 2026 最新节点、价格与解锁实测`}
  description={brand.data.tagline ?? `${brand.data.name} 深度评测报告，含速度、稳定性、流媒体解锁与性价比全面分析。`}
  breadcrumbs={[
    { label: '首页', href: '/' },
    { label: '品牌库', href: '/brands/' },
    { label: brand.data.name },
  ]}
>
  <!-- Brand header hero box -->
  <div slot="header" class="mb-10">
    <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-brand-950 text-white rounded-3xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
      <!-- Background subtle glow -->
      <div class="absolute -right-10 -bottom-10 w-60 h-60 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="flex flex-wrap gap-2 mb-4">
        {brand.data.featured && (
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-amber-500 text-slate-950">
            ★ 2026 精选推荐
          </span>
        )}
        {brand.data.tags.map((t) => (
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-800 text-slate-300 border border-slate-700">
            {t}
          </span>
        ))}
      </div>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex-1">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white mb-3">
            {brand.data.name}
          </h1>
          {brand.data.tagline && (
            <p class="text-base sm:text-lg text-slate-300 font-normal leading-relaxed max-w-2xl mb-4">
              {brand.data.tagline}
            </p>
          )}

          <!-- Rating + Stars -->
          <div class="flex items-center gap-4">
            <div class="flex items-baseline gap-1">
              <span class="text-3xl font-black text-amber-400">{brand.data.rating.toFixed(1)}</span>
              <span class="text-xs text-slate-400">/ 10</span>
            </div>
            <div class="text-amber-400 text-base tracking-widest">
              {'★'.repeat(fullStars)}{halfStar ? '☆' : ''}{'☆'.repeat(emptyStars)}
            </div>
            <span class="text-xs text-slate-400 border-l border-slate-700 pl-3">
              已通过 12 维实测
            </span>
          </div>
        </div>

        <!-- Right Side CTA Card -->
        {brand.data.referralId && (
          <div class="bg-white/10 backdrop-blur-md border border-white/10 rounded-2xl p-5 text-center min-w-[220px] flex flex-col justify-center">
            <div class="text-xs text-amber-300 font-medium mb-1">优惠注册入口</div>
            <div class="text-2xl font-black text-white mb-3">
              {brand.data.minPrice !== undefined ? `¥${brand.data.minPrice.toFixed(1)} 起` : '体验好价'}
            </div>
            <a href={`/go/${brand.data.referralId}/`}
               target="_blank"
               rel="noopener noreferrer sponsored"
               class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-sm transition-all duration-200 shadow-lg shadow-amber-500/25 hover:scale-105 active:scale-95">
              前往官网注册
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0L15 6.06V12.75a.75.75 0 001.5 0V4.5a.75.75 0 00-.75-.75H9a.75.75 0 000 1.5h6.69L6.28 13.72a.75.75 0 000 1.06z" clip-rule="evenodd"/>
              </svg>
            </a>
            <p class="text-[10px] text-slate-400 mt-2">安全加密跳转 · 实时最新入口</p>
          </div>
        )}
      </div>
    </div>

    <!-- Quick Parameters Specs Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6">
      <div class="bg-white border border-slate-200/80 rounded-2xl p-4 text-center shadow-xs">
        <div class="text-xs text-slate-400 mb-1">节点/线路类型</div>
        <div class="font-bold text-slate-800 text-sm">{brand.data.nodeTypes.join(' · ') || '专线/中转'}</div>
      </div>
      <div class="bg-white border border-slate-200/80 rounded-2xl p-4 text-center shadow-xs">
        <div class="text-xs text-slate-400 mb-1">支持协议</div>
        <div class="font-bold text-slate-800 text-sm">{brand.data.protocols.join(' · ') || 'Trojan/SS'}</div>
      </div>
      <div class="bg-white border border-slate-200/80 rounded-2xl p-4 text-center shadow-xs">
        <div class="text-xs text-slate-400 mb-1">流媒体与 AI 解锁</div>
        <div class="font-bold text-emerald-600 text-sm">{brand.data.streamingSupport.join(' · ') || '全平台'}</div>
      </div>
      <div class="bg-white border border-slate-200/80 rounded-2xl p-4 text-center shadow-xs">
        <div class="text-xs text-slate-400 mb-1">最低价格</div>
        <div class="font-bold text-amber-600 text-sm">
          {brand.data.minPrice !== undefined ? `¥${brand.data.minPrice.toFixed(1)}/月起` : '面议'}
        </div>
      </div>
    </div>
  </div>

  <!-- Brand review markdown content -->
  <div class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-10 shadow-xs mb-12">
    <div class="prose-cn">
      <Content />
    </div>

    <!-- Additional Inline CTA inside markdown article end -->
    {brand.data.referralId && (
      <div class="mt-10 p-6 rounded-2xl bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200/80 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h4 class="font-bold text-slate-900 text-base mb-1">准备体验 {brand.data.name}？</h4>
          <p class="text-xs text-slate-600">点击下方按钮访问官网，获取最新优惠套餐与节点订阅。</p>
        </div>
        <a href={`/go/${brand.data.referralId}/`}
           target="_blank"
           rel="noopener noreferrer sponsored"
           class="btn-amber whitespace-nowrap text-sm px-6 py-2.5">
          立即访问 {brand.data.name} 官网 →
        </a>
      </div>
    )}
  </div>

  <!-- Related Posts -->
  {relatedPosts.length > 0 && (
    <div class="mb-12">
      <h3 class="text-xl font-extrabold text-slate-900 mb-4">相关测评与教程文章</h3>
      <RelatedPosts posts={relatedPosts} />
    </div>
  )}

  <!-- Newsletter -->
  <div class="mt-10">
    <NewsletterBox />
  </div>
</LandingLayout>

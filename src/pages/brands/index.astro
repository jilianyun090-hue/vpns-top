---
import BaseLayout   from '../../layouts/BaseLayout.astro';
import BrandCard    from '../../components/BrandCard.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { getCollection } from 'astro:content';
import { compareBrands } from '../../data/brandOrder';

const allBrands = await getCollection('brands');
const sorted = allBrands.sort(compareBrands);
---

<BaseLayout
  title="2026 机场推荐品牌库：VPN 机场与节点对比"
  description="集中查看2026机场推荐品牌与VPN机场信息，按节点线路、协议、流媒体支持、价格和综合评分筛选稳定或高性价比机场。"
>
  <div class="container-xl py-10 lg:py-14">
    <SectionTitle
      headingLevel={1}
      id="brands-index-heading"
      title="机场推荐品牌与 VPN 机场库"
      subtitle={`收录 ${sorted.length} 家服务商，按节点线路、协议、价格与综合评分辅助筛选。`}
      tag="品牌"
    />

    {sorted.length > 0 ? (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {sorted.map((brand) => (
          <BrandCard
            name={brand.data.name}
            slug={brand.slug}
            rating={brand.data.rating}
            tagline={brand.data.tagline}
            nodeTypes={brand.data.nodeTypes}
            streamingSupport={brand.data.streamingSupport}
            minPrice={brand.data.minPrice}
            referralId={brand.data.referralId}
            tags={brand.data.tags}
            featured={brand.data.featured}
          />
        ))}
      </div>
    ) : (
      <p class="text-slate-500 text-center py-20">品牌收录中，敬请期待。</p>
    )}
  </div>
</BaseLayout>

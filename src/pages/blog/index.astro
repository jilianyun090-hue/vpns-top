---
import BaseLayout   from '../../layouts/BaseLayout.astro';
import ArticleCard  from '../../components/ArticleCard.astro';
import CategoryNav  from '../../components/CategoryNav.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sorted = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Collect unique tags
const allTags = [...new Set(sorted.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout
  title="机场推荐、VPN 软件与梯子评测文章"
  description="汇总2026机场推荐、VPN软件推荐、梯子排行、机场节点与客户端教程，覆盖稳定性、性价比、流媒体解锁和故障排查。"
>
  <div class="container-xl py-10 lg:py-14">
    <SectionTitle
      headingLevel={1}
      id="blog-index-heading"
      title="机场推荐、VPN 软件与梯子评测"
      subtitle={`共 ${sorted.length} 篇选购、评测与使用指南，持续更新机场节点、稳定性和性价比信息。`}
      tag="BLOG"
    />

    <!-- Category filter -->
    <div class="mb-8">
      <CategoryNav showTags tags={allTags} />
    </div>

    {sorted.length > 0 ? (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {sorted.map((post) => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            href={`/blog/${post.slug}/`}
            category={post.data.category}
            tags={post.data.tags}
            pubDate={post.data.pubDate}
            updatedDate={post.data.updatedDate}
            featured={post.data.featured}
          />
        ))}
      </div>
    ) : (
      <p class="text-slate-500 text-center py-20">暂无文章，敬请期待。</p>
    )}
  </div>
</BaseLayout>

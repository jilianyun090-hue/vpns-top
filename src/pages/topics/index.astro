---
import BaseLayout    from '../../layouts/BaseLayout.astro';
import TopicCluster  from '../../components/TopicCluster.astro';
import SectionTitle  from '../../components/SectionTitle.astro';
import { getCollection } from 'astro:content';

const allTopics = await getCollection('topics', ({ data }) => !data.draft);
const sorted = allTopics.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="机场与 VPN 知识专题：流媒体、配置、安全与评测方法"
  description="系统整理机场推荐、VPN机场、机场节点、流媒体解锁、客户端配置、隐私安全与评测方法，按专题连续阅读，并查看术语说明、判断步骤和相关教程，方便对照核验方法与使用场景。"
>
  <div class="container-xl py-10 lg:py-14">
    <SectionTitle
      headingLevel={1}
      id="topics-index-heading"
      title="专题大厅"
      subtitle="精心策划的主题合集，系统深入掌握翻墙与科学上网知识体系。"
      tag="专题"
    />

    <div class="grid sm:grid-cols-2 gap-4">
      {sorted.map((topic) => (
        <TopicCluster
          title={topic.data.title}
          description={topic.data.description}
          href={`/topics/${topic.slug}/`}
          articleCount={topic.data.articleCount}
          tags={topic.data.tags}
        />
      ))}
    </div>

    {sorted.length === 0 && (
      <p class="text-slate-500 text-center py-20">专题建设中，敬请期待。</p>
    )}
  </div>
</BaseLayout>

---
import LandingLayout from '../../layouts/LandingLayout.astro';
import ArticleCard   from '../../components/ArticleCard.astro';
import SectionTitle  from '../../components/SectionTitle.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const topics = await getCollection('topics', ({ data }) => !data.draft);
  return topics.map((topic) => ({
    params: { slug: topic.slug },
    props:  { topic },
  }));
}) satisfies GetStaticPaths;

const { topic } = Astro.props;
const { Content } = await topic.render();

// Find related blog posts by tag overlap
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
  .filter((p) => p.data.tags.some((t) => topic.data.tags.includes(t)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<LandingLayout
  title={topic.data.title}
  description={topic.data.description}
  breadcrumbs={[
    { label: '首页', href: '/' },
    { label: '专题', href: '/topics/' },
    { label: topic.data.title },
  ]}
>
  <!-- Topic header -->
  <div slot="header" class="mb-10">
    <div class="flex flex-wrap gap-2 mb-4">
      {topic.data.tags.map((t) => <span class="badge badge-brand">#{t}</span>)}
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-white mb-4">{topic.data.title}</h1>
    <p class="text-lg text-slate-400">{topic.data.description}</p>
    <div class="mt-3 text-sm text-slate-600">共收录 {topic.data.articleCount} 篇文章</div>
  </div>

  <!-- Topic content (from markdown) -->
  <div class="prose-cn mb-12">
    <Content />
  </div>

  <!-- Related articles -->
  {related.length > 0 && (
    <section>
      <SectionTitle title="专题文章" subtitle="本专题收录的深度评测与教程。" />
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {related.map((post) => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            href={`/blog/${post.slug}/`}
            category={post.data.category}
            tags={post.data.tags}
            pubDate={post.data.pubDate}
            updatedDate={post.data.updatedDate}
            featured={post.data.featured}
          />
        ))}
      </div>
    </section>
  )}
</LandingLayout>
